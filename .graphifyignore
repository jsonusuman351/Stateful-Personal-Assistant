# ─────────────────────────────────────────────────────────────────────────────
# .graphifyignore — patterns graphify skips when scanning this repo.
# Same glob syntax as .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env
.env.*

# ── Graphify own output (don't re-read what you already wrote) ────────────────
graphify-out/
.graphify_python
.graphify_*.json
.graphify_*.txt

# ── Git internals ─────────────────────────────────────────────────────────────
.git/

# ── Python bytecode and caches ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.mypy_cache/
.ruff_cache/
.pytype/

# ── Test and coverage artefacts ───────────────────────────────────────────────
.pytest_cache/
htmlcov/
coverage.xml
coverage.json
.coverage
*.lcov

# ── Build / distribution ──────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
*.whl
.eggs/

# ── IDE metadata ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.swp
*.swo
*.DS_Store

# ── Logs and secrets ─────────────────────────────────────────────────────────
logs/
*.log
*.pem
*.key
secrets/
