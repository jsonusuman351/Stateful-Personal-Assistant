# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values before running the app.
# All variables listed here are read by src/config/settings.py at startup.
# NEVER commit the real .env file to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required: LLM ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-replace-me  # pragma: allowlist secret

# ── Required: Database ────────────────────────────────────────────────────────
# asyncpg dialect: postgresql+asyncpg://user:pass@host:5432/dbname  # pragma: allowlist secret
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/assistant  # pragma: allowlist secret

# ── Required: Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Required: JWT ─────────────────────────────────────────────────────────────
# JWT_SECRET must be at least 32 bytes, base64-encoded random value.
# Generate: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
JWT_SECRET=replace-with-at-least-32-bytes-of-base64-encoded-random-data  # pragma: allowlist secret
JWT_ISSUER=stateful-assistant
JWT_AUDIENCE=stateful-assistant-users

# ── Optional: External APIs ───────────────────────────────────────────────────
TAVILY_API_KEY=tvly-replace-me  # pragma: allowlist secret
WEATHER_API_KEY=replace-me  # pragma: allowlist secret
LANGSMITH_API_KEY=lsv2_replace-me  # pragma: allowlist secret

# ── LLM configuration ─────────────────────────────────────────────────────────
OPENAI_DEFAULT_MODEL=gpt-4o-mini
# JSON array of fallback model identifiers. Omit or set to [] to disable fallback.
# Example: FALLBACK_MODELS=["groq/llama-3-70b"]
# FALLBACK_MODELS=

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_LOCKOUT_MINUTES=15

# ── Startup resilience ────────────────────────────────────────────────────────
# When true (default, NFR-10), the app exits non-zero if the database is
# unreachable at startup (migrations / checkpointer). Set to false on hosts
# where the DB may be temporarily down (e.g. a suspended Render free-tier DB)
# so the app boots in DEGRADED mode: non-DB endpoints work and DB-backed
# requests return a clean 503 instead of crashing the process.
STARTUP_DB_REQUIRED=true

# ── Connection pools (NFR-7) ──────────────────────────────────────────────────
DB_POOL_MIN=2
DB_POOL_MAX=10
REDIS_POOL_MIN=2
REDIS_POOL_MAX=10

# ── Logging ───────────────────────────────────────────────────────────────────
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── CORS (NFR-14) ─────────────────────────────────────────────────────────────
# JSON array of allowed origins. Never use ["*"] in production.
# Example: CORS_ORIGINS=["http://localhost:3000","https://myapp.example.com"]
CORS_ORIGINS=["http://localhost:3000"]

# ── Quota windows (FR-26, FR-31) ──────────────────────────────────────────────
QUOTA_4H_REQUESTS=20
QUOTA_24H_REQUESTS=100
QUOTA_7D_REQUESTS=500
QUOTA_4H_TOKENS=50000
QUOTA_24H_TOKENS=200000
QUOTA_7D_TOKENS=1000000
